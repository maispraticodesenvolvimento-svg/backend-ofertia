FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com
FIREBASE_CLIENT_EMAIL=service-account@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_PRIVADA_DA_CONTA_DE_SERVICO\n-----END PRIVATE KEY-----\n"

# Chave da Web API usada pelo backend para autenticar e-mail e senha no Firebase.
# Mantenha este valor somente no ambiente do servidor.
FIREBASE_API_KEY=sua-web-api-key

MEDIA_MAX_SIZE_MB=8
FRONTEND_ORIGIN=http://localhost:56500
